{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make doctor)",
      "Bash(make context)",
      "Bash(make harness)",
      "Bash(make fmt)",
      "Bash(make fmt-check)",
      "Bash(make check)",
      "Bash(make lint)",
      "Bash(make test)",
      "Bash(make wit-check)",
      "Bash(make ci)",
      "Bash(make run-headless)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*secret*)",
      "Read(**/*credential*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)"
    ],
    "defaultMode": "default"
  }
}
